<?xml version="1.0" encoding="utf-8"?>
<robot name="ruggedized_wrist_web">
  <!-- Browser-optimized kinematic model. The two movable joints retain the axes
       and limits of the manufacturing URDF while primitive geometry keeps the
       interactive download small and deterministic. -->
  <material name="graphite"><color rgba="0.16 0.19 0.22 1"/></material>
  <material name="aluminum"><color rgba="0.76 0.79 0.81 1"/></material>
  <material name="wrist_blue"><color rgba="0.08 0.48 0.66 1"/></material>
  <material name="joint_gold"><color rgba="0.94 0.61 0.10 1"/></material>
  <material name="probe"><color rgba="0.82 0.86 0.88 1"/></material>
  <material name="probe_face"><color rgba="0.20 0.25 0.27 1"/></material>

  <link name="root"/>

  <link name="wrist_base">
    <visual>
      <origin xyz="0 0 0.009"/>
      <geometry><cylinder radius="0.039" length="0.018"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.043"/>
      <geometry><box size="0.072 0.058 0.058"/></geometry>
      <material name="aluminum"/>
    </visual>
    <visual>
      <origin xyz="0.038 0 0.043" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.022" length="0.050"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <origin xyz="0.038 -0.027 0.043" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.014" length="0.005"/></geometry>
      <material name="joint_gold"/>
    </visual>
  </link>
  <joint name="root_to_base" type="fixed">
    <parent link="root"/>
    <child link="wrist_base"/>
  </joint>

  <link name="roll_motor_housing">
    <visual>
      <origin xyz="0 0 0.034"/>
      <geometry><box size="0.052 0.052 0.068"/></geometry>
      <material name="wrist_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.071"/>
      <geometry><cylinder radius="0.032" length="0.012"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <origin xyz="0 -0.029 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.020" length="0.008"/></geometry>
      <material name="joint_gold"/>
    </visual>
  </link>
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_base"/>
    <child link="roll_motor_housing"/>
    <origin xyz="0 0 0.072"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="12" velocity="3.0"/>
  </joint>

  <link name="roll_output">
    <visual>
      <origin xyz="0 0 0.008"/>
      <geometry><cylinder radius="0.025" length="0.016"/></geometry>
      <material name="joint_gold"/>
    </visual>
    <visual>
      <origin xyz="0.021 0 0.021"/>
      <geometry><box size="0.012 0.026 0.026"/></geometry>
      <material name="graphite"/>
    </visual>
  </link>
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="roll_motor_housing"/>
    <child link="roll_output"/>
    <origin xyz="0 0 0.082"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="8" velocity="4.0"/>
  </joint>

  <link name="gecko_attachment">
    <visual>
      <origin xyz="0 0 0.036"/>
      <geometry><box size="0.036 0.052 0.072"/></geometry>
      <material name="probe"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.078"/>
      <geometry><box size="0.028 0.044 0.012"/></geometry>
      <material name="probe_face"/>
    </visual>
    <visual>
      <origin xyz="0.023 0 0.034"/>
      <geometry><box size="0.010 0.018 0.038"/></geometry>
      <material name="wrist_blue"/>
    </visual>
  </link>
  <joint name="roll_output_to_gecko" type="fixed">
    <parent link="roll_output"/>
    <child link="gecko_attachment"/>
    <origin xyz="0 0 0.016"/>
  </joint>
</robot>
